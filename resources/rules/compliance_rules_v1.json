{
  "version": "2.0.0",
  "updated_at": "2026-05-18",
  "description": "MedMemo 合规拦截规则库 v2.0 — 覆盖四级风险等级 + inline 用词替换",
  "rules": [
    {
      "id": "l1-diag-inline-001",
      "level": "L1",
      "name": "确定性诊断用语-你患有",
      "patterns": ["你患有([一-龥]+)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "您的情况可能与${1}有关，建议咨询医生确认"
    },
    {
      "id": "l1-diag-inline-002",
      "level": "L1",
      "name": "确定性诊断用语-确诊为",
      "patterns": ["确诊为([一-龥]+)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "检查结果可能与${1}有关，需由医生面诊后确认"
    },
    {
      "id": "l1-diag-inline-003",
      "level": "L1",
      "name": "确定性诊断用语-诊断是",
      "patterns": ["诊断是([一-龥]+)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "初步判断可能与${1}有关，建议进一步咨询专业医生"
    },
    {
      "id": "l1-diag-inline-004",
      "level": "L1",
      "name": "确定性诊断用语-你得了",
      "patterns": ["你得了([一-龥]+病?)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "您出现的症状可能与${1}有关，建议前往医院就诊"
    },
    {
      "id": "l1-diag-inline-005",
      "level": "L1",
      "name": "确定性诊断用语-你是患者",
      "patterns": ["你是([一-龥]+)患者"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "您的情况可能涉及${1}，建议咨询专科医生评估"
    },
    {
      "id": "l1-diag-inline-006",
      "level": "L1",
      "name": "确定性诊断用语-确定是",
      "patterns": ["确定是([一-龥]+病?)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "目前信息有限，是否为${1}需由医生判断"
    },
    {
      "id": "l1-diag-inline-007",
      "level": "L1",
      "name": "确定性诊断用语-肯定是",
      "patterns": ["肯定是([一-龥]+病?)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "可能需要注意${1}相关情况，建议咨询医生确认"
    },
    {
      "id": "l1-diag-inline-008",
      "level": "L1",
      "name": "确定性诊断用语-你就是",
      "patterns": ["你就是([一-龥]+病?)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "您的症状表现可能与${1}有关，建议就医排查"
    },
    {
      "id": "l1-diag-inline-009",
      "level": "L1",
      "name": "确定性诊断用语-属于",
      "patterns": ["属于([一-龥]+病?)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "可能属于${1}范畴，需由医生面诊后明确"
    },
    {
      "id": "l1-diag-inline-010",
      "level": "L1",
      "name": "确定性诊断用语-可以确诊",
      "patterns": ["可以确诊"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "目前信息不足以做出判断，建议咨询医生"
    },
    {
      "id": "l1-diag-inline-011",
      "level": "L1",
      "name": "确定性诊断用语-已经确诊",
      "patterns": ["已经确诊"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "确诊需由专业医生通过面诊和相关检查完成"
    },
    {
      "id": "l1-diag-inline-012",
      "level": "L1",
      "name": "确定性诊断用语-必须治疗",
      "patterns": ["必须治疗"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "治疗方案需由医生面诊后制定"
    },
    {
      "id": "l1-diag-inline-013",
      "level": "L1",
      "name": "确定性诊断用语-必须服用",
      "patterns": ["必须服用"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "用药需遵医嘱，请咨询执业医生或药师"
    },
    {
      "id": "l1-diag-inline-014",
      "level": "L1",
      "name": "确定性诊断用语-必须做",
      "patterns": ["必须做([一-龥]+)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "是否需要进行${1}，建议咨询医生后决定"
    },
    {
      "id": "l1-diag-inline-015",
      "level": "L1",
      "name": "确定性诊断用语-必须立即",
      "patterns": ["必须立即"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "如出现紧急症状，建议尽快就医或拨打急救电话"
    },
    {
      "id": "l1-diag-inline-016",
      "level": "L1",
      "name": "确定性诊断用语-肯定是得了",
      "patterns": ["肯定是得了([一-龥]+病?)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "您的情况可能与${1}有关，建议咨询医生确认"
    },
    {
      "id": "l1-diag-inline-017",
      "level": "L1",
      "name": "确定性诊断用语-你这就是",
      "patterns": ["你这就是([一-龥]+病?)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "您的情况可能与$1有关，建议咨询医生确认"
    },
    {
      "id": "l1-diag-inline-018",
      "level": "L1",
      "name": "确定性诊断用语-这是典型的",
      "patterns": ["这是典型的([一-龥]+)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "这些表现可能与${1}有关，建议就医排查"
    },
    {
      "id": "l1-diag-inline-019",
      "level": "L1",
      "name": "确定性诊断用语-完全可以确定",
      "patterns": ["完全可以确定"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "目前的症状信息有限，建议咨询医生进一步评估"
    },
    {
      "id": "l1-diag-inline-020",
      "level": "L1",
      "name": "确定性诊断用语-毋庸置疑",
      "patterns": ["毋庸置疑"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "具体情况建议咨询医生进行专业评估"
    },
    {
      "id": "l1-diag-definite-001",
      "level": "L1",
      "name": "确诊性诊断结论",
      "patterns": [
        "你患有[一-龥]+病",
        "确诊为[一-龥]+",
        "诊断是[一-龥]+",
        "确定是[一-龥]+病",
        "你得了[一-龥]+病",
        "你是[一-龥]+患者"
      ],
      "action": "block",
      "replacement": "我无法提供医疗诊断或治疗建议。如有健康疑虑，请咨询持有合法资质的专业医生。"
    },
    {
      "id": "l1-drug-dose-001",
      "level": "L1",
      "name": "药物剂量处方",
      "patterns": [
        "服用\\s*\\d+\\s*(?:毫克|mg|g|克|ml|毫升)",
        "每日\\s*\\d+\\s*次.*(?:片|粒|支| capsule|tablet)",
        "每次\\s*\\d+\\s*(?:片|粒|支|mg|毫克)",
        "剂量为\\s*\\d+",
        "建议用量\\s*\\d+"
      ],
      "action": "block",
      "replacement": "我无法提供药物剂量或用药建议。请遵医嘱或咨询执业药师。"
    },
    {
      "id": "l1-surgery-001",
      "level": "L1",
      "name": "手术或治疗方案建议",
      "patterns": [
        "建议手术",
        "需要开刀",
        "必须切除",
        "必须住院",
        "必须化疗",
        "必须放疗",
        "治疗方案是[一-龥]+"
      ],
      "action": "block",
      "replacement": "我无法提供治疗方案或手术建议。具体治疗方案需由医生面诊后制定。"
    },
    {
      "id": "l1-checklist-001",
      "level": "L1",
      "name": "强制检查单",
      "patterns": [
        "您需要做.*检查",
        "您必须做.*化验",
        "立即做.*CT",
        "立即做.*核磁",
        "马上做.*B超"
      ],
      "action": "block",
      "replacement": "我无法开具检查单。具体检查项目需由医生根据面诊情况判断。"
    },
    {
      "id": "l1-diag-definite-002",
      "level": "L1",
      "name": "疾病诊断断言",
      "patterns": [
        "这就是[一-龥]+病",
        "肯定是[一-龥]+病",
        "无疑是[一-龥]+病",
        "典型的[一-龥]+病"
      ],
      "action": "block",
      "replacement": "我无法提供医疗诊断。症状分析仅供参考，确诊需由医生完成。"
    },
    {
      "id": "l1-drug-otc-inline-001",
      "level": "L1",
      "name": "药物推荐用语-inline",
      "patterns": ["你可以吃([一-龥]+药?)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "关于${1}的使用，请咨询医生或药师"
    },
    {
      "id": "l1-drug-otc-inline-002",
      "level": "L1",
      "name": "药物推荐用语-试试-inline",
      "patterns": ["试试([一-龥]+药?)"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "${1}是否适合您，建议咨询医生或药师评估"
    },
    {
      "id": "l1-drug-otc-inline-003",
      "level": "L1",
      "name": "药物推荐用语-用-inline",
      "patterns": ["用([一-龥]+药?).*可以治好"],
      "action": "block",
      "replace_mode": "inline",
      "replacement": "${1}的治疗效果因人而异，请遵医嘱用药"
    },
    {
      "id": "l2-diag-implied-001",
      "level": "L2",
      "name": "暗示性诊断",
      "patterns": [
        "可能是[一-龥]+病",
        "不排除[一-龥]+",
        "疑似[一-龥]+",
        "倾向于[一-龥]+诊断"
      ],
      "action": "warn",
      "warning": "以上内容仅为信息参考，不能替代专业医疗诊断。"
    },
    {
      "id": "l2-diag-implied-002",
      "level": "L2",
      "name": "暗示性诊断-扩展",
      "patterns": [
        "看起来像是[一-龥]+",
        "比较像[一-龥]+",
        "有[一-龥]+的可能",
        "风险较高"
      ],
      "action": "warn",
      "warning": "以上内容仅为信息参考，不能替代专业医疗诊断。"
    },
    {
      "id": "l2-drug-otc-001",
      "level": "L2",
      "name": "非处方药推荐",
      "patterns": [
        "可以买[一-龥]+药",
        "建议服用[一-龥]+",
        "吃点[一-龥]+药",
        "试试[一-龥]+胶囊",
        "用[一-龥]+软膏"
      ],
      "action": "warn",
      "warning": "用药建议仅供参考，具体用药请遵医嘱或咨询药师。"
    },
    {
      "id": "l2-drug-otc-002",
      "level": "L2",
      "name": "保健品/偏方推荐",
      "patterns": [
        "试试[一-龥]+偏方",
        "推荐[一-龥]+保健品",
        "可以喝[一-龥]+茶调理"
      ],
      "action": "warn",
      "warning": "保健品和偏方不能替代正规医疗，如有健康疑虑请咨询医生。"
    },
    {
      "id": "l2-check-suggest-001",
      "level": "L2",
      "name": "检查项目建议",
      "patterns": [
        "建议查一下[一-龥]+",
        "最好做个[一-龥]+检查",
        "可以做个[一-龥]+排查"
      ],
      "action": "warn",
      "warning": "检查建议仅供参考，具体检查项目需由医生判断。"
    },
    {
      "id": "l2-check-suggest-002",
      "level": "L2",
      "name": "检查项目建议-扩展",
      "patterns": [
        "需要查一下[一-龥]+",
        "有必要做[一-龥]+检查",
        "应该做个[一-龥]+看看"
      ],
      "action": "warn",
      "warning": "检查建议仅供参考，具体检查项目需由医生判断。"
    },
    {
      "id": "l2-treatment-suggest-001",
      "level": "L2",
      "name": "治疗方式建议",
      "patterns": [
        "建议采用[一-龥]+治疗",
        "可以考虑[一-龥]+疗法",
        "最好进行[一-龥]+康复"
      ],
      "action": "warn",
      "warning": "治疗建议仅供参考，具体治疗方案需由医生面诊后制定。"
    },
    {
      "id": "l3-disease-severe-001",
      "level": "L3",
      "name": "严重疾病科普",
      "patterns": [
        "癌症",
        "恶性肿瘤",
        "白血病",
        "艾滋病",
        "阿尔茨海默",
        "帕金森",
        "脑卒中",
        "心肌梗死",
        "肝衰竭",
        "肾衰竭"
      ],
      "action": "notice",
      "notice": "以上内容仅为健康科普信息，不能替代专业医疗诊断。如有相关症状，请及时就医。"
    },
    {
      "id": "l3-disease-severe-002",
      "level": "L3",
      "name": "严重疾病科普-扩展",
      "patterns": [
        "肺癌",
        "胃癌",
        "肝癌",
        "乳腺癌",
        "结直肠癌",
        "淋巴瘤"
      ],
      "action": "notice",
      "notice": "以上内容仅为健康科普信息，不能替代专业医疗诊断。如有相关症状，请及时就医。"
    },
    {
      "id": "l3-disease-chronic-001",
      "level": "L3",
      "name": "重大慢性病科普",
      "patterns": [
        "糖尿病并发症",
        "高血压危象",
        "冠心病",
        "脑溢血",
        "肝硬化",
        "尿毒症"
      ],
      "action": "notice",
      "notice": "慢性病管理需遵循医嘱，以上内容仅供信息参考。"
    },
    {
      "id": "l3-disease-chronic-002",
      "level": "L3",
      "name": "重大慢性病科普-扩展",
      "patterns": [
        "2型糖尿病",
        "1型糖尿病",
        "高血压",
        "慢性肾病",
        "慢性阻塞性肺病",
        "类风湿关节炎"
      ],
      "action": "notice",
      "notice": "慢性病管理需遵循医嘱，以上内容仅供信息参考。"
    },
    {
      "id": "l3-mental-health-001",
      "level": "L3",
      "name": "心理健康科普",
      "patterns": [
        "抑郁症",
        "焦虑症",
        "双相情感障碍",
        "精神分裂症"
      ],
      "action": "notice",
      "notice": "心理健康问题需专业评估，以上内容仅供信息参考。如有需要请及时寻求专业帮助。"
    }
  ]
}
