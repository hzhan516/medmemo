{
  "version": "1.0.0",
  "updated_at": "2026-05-18",
  "description": "MedMemo 合规拦截规则库 v1.0 — 覆盖四级风险等级",
  "rules": [
    {
      "id": "l1-diag-definite-001",
      "level": "L1",
      "name": "确诊性诊断结论",
      "patterns": [
        "你患有[一-龥]+病",
        "确诊为[一-龥]+",
        "诊断是[一-龥]+",
        "确定是[一-龥]+病",
        "你得了[一-龥]+病",
        "你是[一-龥]+患者"
      ],
      "action": "block",
      "replacement": "我无法提供医疗诊断或治疗建议。如有健康疑虑，请咨询持有合法资质的专业医生。"
    },
    {
      "id": "l1-drug-dose-001",
      "level": "L1",
      "name": "药物剂量处方",
      "patterns": [
        "服用\\s*\\d+\\s*(?:毫克|mg|g|克|ml|毫升)",
        "每日\\s*\\d+\\s*次.*(?:片|粒|支| capsule|tablet)",
        "每次\\s*\\d+\\s*(?:片|粒|支|mg|毫克)",
        "剂量为\\s*\\d+",
        "建议用量\\s*\\d+"
      ],
      "action": "block",
      "replacement": "我无法提供药物剂量或用药建议。请遵医嘱或咨询执业药师。"
    },
    {
      "id": "l1-surgery-001",
      "level": "L1",
      "name": "手术或治疗方案建议",
      "patterns": [
        "建议手术",
        "需要开刀",
        "必须切除",
        "必须住院",
        "必须化疗",
        "必须放疗",
        "治疗方案是[一-龥]+"
      ],
      "action": "block",
      "replacement": "我无法提供治疗方案或手术建议。具体治疗方案需由医生面诊后制定。"
    },
    {
      "id": "l1-checklist-001",
      "level": "L1",
      "name": "强制检查单",
      "patterns": [
        "您需要做.*检查",
        "您必须做.*化验",
        "立即做.*CT",
        "立即做.*核磁",
        "马上做.*B超"
      ],
      "action": "block",
      "replacement": "我无法开具检查单。具体检查项目需由医生根据面诊情况判断。"
    },
    {
      "id": "l2-diag-implied-001",
      "level": "L2",
      "name": "暗示性诊断",
      "patterns": [
        "可能是[一-龥]+病",
        "不排除[一-龥]+",
        "疑似[一-龥]+",
        "倾向于[一-龥]+诊断"
      ],
      "action": "warn",
      "warning": "以上内容仅为信息参考，不能替代专业医疗诊断。"
    },
    {
      "id": "l2-drug-otc-001",
      "level": "L2",
      "name": "非处方药推荐",
      "patterns": [
        "可以买[一-龥]+药",
        "建议服用[一-龥]+",
        "吃点[一-龥]+药",
        "试试[一-龥]+胶囊",
        "用[一-龥]+软膏"
      ],
      "action": "warn",
      "warning": "用药建议仅供参考，具体用药请遵医嘱或咨询药师。"
    },
    {
      "id": "l2-check-suggest-001",
      "level": "L2",
      "name": "检查项目建议",
      "patterns": [
        "建议查一下[一-龥]+",
        "最好做个[一-龥]+检查",
        "可以做个[一-龥]+排查"
      ],
      "action": "warn",
      "warning": "检查建议仅供参考，具体检查项目需由医生判断。"
    },
    {
      "id": "l3-disease-severe-001",
      "level": "L3",
      "name": "严重疾病科普",
      "patterns": [
        "癌症",
        "恶性肿瘤",
        "白血病",
        "艾滋病",
        "阿尔茨海默",
        "帕金森",
        "脑卒中",
        "心肌梗死",
        "肝衰竭",
        "肾衰竭"
      ],
      "action": "notice",
      "notice": "以上内容仅为健康科普信息，不能替代专业医疗诊断。如有相关症状，请及时就医。"
    },
    {
      "id": "l3-disease-chronic-001",
      "level": "L3",
      "name": "重大慢性病科普",
      "patterns": [
        "糖尿病并发症",
        "高血压危象",
        "冠心病",
        "脑溢血",
        "肝硬化",
        "尿毒症"
      ],
      "action": "notice",
      "notice": "慢性病管理需遵循医嘱，以上内容仅供信息参考。"
    }
  ]
}
