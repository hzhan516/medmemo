+func (r *migratorEmbeddingRepo) SearchSimilarFiltered(ctx context.Context, queryVector []float32, topK int, modelVersion string) ([]*entity.ScoredEmbedding, error) {
+	return r.SearchSimilar(ctx, queryVector, topK)
+}
