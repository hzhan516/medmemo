           GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
 
       - name: Publish Release
-        run: gh release edit "${{ needs.version.outputs.version }}" --draft=false --repo "${{ github.repository }}"
+        run: |
+          TAG="${{ needs.version.outputs.version }}"
+          REPO="${{ github.repository }}"
+          MAX_RETRIES=5
+          DELAY=10
+
+          for i in $(seq 1 $MAX_RETRIES); do
+            echo "Attempt $i/$MAX_RETRIES: Publishing release $TAG..."
+
+            # 幂等检查：若已被发布则直接成功
+            # stderr 保留到日志用于排查，通过 set +e 捕获退出码避免吞掉认证失败等真实错误
+            set +e
+            DRAFT_JSON=$(gh release view "$TAG" --repo "$REPO" --json isDraft 2>/tmp/gh_view_err)
+            VIEW_EXIT=$?
+            set -e
+
+            if [ $VIEW_EXIT -eq 0 ]; then
+              DRAFT_STATUS=$(echo "$DRAFT_JSON" | jq -r '.isDraft')
+              if [ "$DRAFT_STATUS" = "false" ]; then
+                echo "Release $TAG is already published."
+                exit 0
+              fi
+            else
+              echo "gh release view exited with code $VIEW_EXIT, stderr:"
+              cat /tmp/gh_view_err
+            fi
+
+            if gh release edit "$TAG" --draft=false --repo "$REPO"; then
+              echo "Release published successfully."
+              exit 0
+            fi
+
+            if [ $i -lt $MAX_RETRIES ]; then
+              echo "Waiting ${DELAY}s before retry..."
+              sleep $DELAY
+              DELAY=$((DELAY * 2))
+            fi
+          done
+
+          echo "Failed to publish release after $MAX_RETRIES attempts."
+          exit 1
         env:
           GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
