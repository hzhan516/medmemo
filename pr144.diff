+func setupFactMigrationTestDB(t *testing.T) (*FactRepoSQLite, *EmbeddingRepoSQLite, func()) {
+	t.Helper()
+	tmpDir := t.TempDir()
+	connector, err := database.NewSQLiteConnector(tmpDir)
