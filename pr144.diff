+// truncateSnippet 截断文本为指定长度的诊断用 snippet。
+func truncateSnippet(s string, maxLen int) string {
+	if s == "" {
+		return ""
+	}
+	runes := []rune(s)
+	if len(runes) <= maxLen {
+		return s
+	}
+	return string(runes[:maxLen]) + "..."
+}
